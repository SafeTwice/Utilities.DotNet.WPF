<Window x:Class="Utilities.DotNet.WPF.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Utilities.DotNet.WPF.Demo"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ux="clr-namespace:Utilities.DotNet.WPF.MarkupExtensions;assembly=Utilities.DotNet.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type local:MainWindow}, IsDesignTimeCreatable=True}"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <x:Array x:Key="Items" Type="sys:String">
            <sys:String>10.5</sys:String>
            <sys:String>50.2</sys:String>
            <sys:String>23.7</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Other Stuff" IsSelected="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="(1):" Margin="5" HorizontalAlignment="Right"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Make (2) Invisible" IsChecked="False" VerticalAlignment="Center" Margin="5"
                              x:Name="Item21"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Value [es] (2):" Margin="5" HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True"
                             Text="{ux:Format FormatString='(3) left thickness > 3: {0}',
                                              P0={ux:Xor A={ux:IsGreater A={ux:Bind Path=BorderThickness.Left, ElementName=Item23},
                                                                         B=3.0},
                                                         B=false}}"
                             x:Name="Item22" Language="es" Visibility="{ux:VisibleWhen Condition={ux:Not I={ux:Bind Path=IsChecked, ElementName=Item21}}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Thickness (3):" Margin="5" HorizontalAlignment="Right"/>
                    <Border Grid.Row="2" Grid.Column="1" BorderThickness="{ux:Thickness Left={ux:Bind Path=Value, ElementName=Item230},
                                                                                        Top={ux:Bind Path=Value, ElementName=Item231},
                                                                                        Right={ux:Bind Path=Value, ElementName=Item232},
                                                                                        Bottom={ux:Bind Path=Value, ElementName=Item233}}"
                            BorderBrush="{ux:Choice Condition={ux:IsGreater A={ux:Bind Path=BorderThickness.Top, ElementName=Item23}, B=2.0},
                                                    True={x:Static Brushes.Red}, False={x:Static Brushes.Black}}"
                            x:Name="Item23">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition MinWidth="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left:" Margin="5" HorizontalAlignment="Right"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="5" Value="1" Margin="5"
                                    x:Name="Item230"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="5"
                                       Text="{ux:ToString FormatString=F2, Value={ux:Bind Path=Value, ElementName=Item230}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Top:" Margin="5" HorizontalAlignment="Right"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5" Value="1" Margin="5"
                                    x:Name="Item231"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="5"
                                       Text="{ux:ToString FormatString=F2, Value={ux:Bind Path=Value, ElementName=Item231}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right:" Margin="5" HorizontalAlignment="Right"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" Value="1" Margin="5"
                                    x:Name="Item232"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="5"
                                       Text="{ux:ToString FormatString=F2, Value={ux:Bind Path=Value, ElementName=Item232}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom:" Margin="5" HorizontalAlignment="Right"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="5" Value="1" Margin="5"
                                    x:Name="Item233"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="5"
                                       Text="{ux:ToString FormatString=F2, Value={ux:Bind Path=Value, ElementName=Item233}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="DataTemplates">
                <ListBox ItemsSource="{StaticResource Items}" Margin="10" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="sys:String">
                            <Border BorderThickness="1" BorderBrush="Black" Margin="5" Padding="5" MinWidth="100">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Value (1):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Mode=OneWay}" Margin="5" IsReadOnly="True"
                                             x:Name="Item1"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Value [es] (2):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{ux:ToDouble Value={ux:Bind Path=Text, ElementName=Item1}}" Margin="5" IsReadOnly="True"
                                             x:Name="Item2" Language="fr"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Calculated Value from (2) [en] (3):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{ux:Add A=80.3, B={ux:Bind Path=Text, ElementName=Item2}}" Margin="5" IsReadOnly="True"
                                             x:Name="Item3" Language="en"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Width from 2 [fr] (4):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{ux:Format FormatString=Width \= {0}, P0={ux:Bind Path=Width, RelativeSource={RelativeSource Self}}}" Margin="5" IsReadOnly="True"
                                             x:Name="Item4" Width="{ux:ToDouble {ux:Bind Path=Text, ElementName=Item3}}" Language="ar"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Numeric value linked to (6) [en] (5):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="66.2" Margin="5"
                                             x:Name="Item5"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Numeric value linked to (5) [es] (6):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{ux:ToDouble Value={ux:Bind Path=Text, ElementName=Item5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}}" Margin="5"
                                             x:Name="Item6" Language="es"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Slider linked to (8) and (9) [en] (7):" Margin="5" HorizontalAlignment="Right"/>
                                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="37"
                                            x:Name="Item7"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Numeric value linked to (7) [en] (8):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="5"
                                             Text="{ux:ToString FormatString=F2, Value={ux:Bind Path=Value, ElementName=Item7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}}"
                                             x:Name="Item8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Calculated value linked to (7) [en] (9):" Margin="5" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Margin="5"
                                             Text="{ux:ToString FormatString=F2,
                                                                Value={ux:Add A={ux:Add A=90, B=10},
                                                                              B={ux:Bind Path=Value, ElementName=Item7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}}}"
                                             x:Name="Item9" Language="es"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Old Stuff">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="75">

                    <TextBox Language="es"
                             Text="50,94"
                             x:Name="OperandAWidth"/>

                    <TextBox Language="en" IsReadOnly="True"
                             Text="{ux:ToDouble Value={ux:Bind Path=Text, ElementName=OperandAWidth}}"/>

                    <TextBox Language="es-ES"
                             Text="25,5"
                             Width="{ux:Bind Text, ElementName=OperandAWidth}"
                             x:Name="OperandA"/>

                    <TextBox Text="50.3"
                             Width="{ux:Add A=50, B={ux:Bind Text, ElementName=OperandAWidth}}"
                             x:Name="OperandB"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:ToString Culture=es-ES, Value={ux:Add A=30.2, B={ux:Bind Path=Text, ElementName=OperandA}}}"/>

                    <TextBox Language="es-ES" IsReadOnly="True"
                             Text="{ux:Add A=30.2, B={ux:Bind Path=Text, ElementName=OperandA}}"/>

                    <TextBox IsReadOnly="True" Language="es"
                             Text="{Binding Width, ElementName=OperandA}"
                             Width="{ux:Bind Text, ElementName=OperandAWidth}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:Add A={ux:Add A={ux:Bind Path=Text, ElementName=OperandA}, B={ux:Bind Path=Text, ElementName=OperandB}}, B=0}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:Add A=300, B=4}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:Multiply A={ux:Add A=11.342, B=30}, B={ux:Add A=10, B=20}}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:Add A=35, B={ux:Bind Text, ElementName=OperandA}}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:ToString {ux:Add A=10, B={ux:Bind Text, ElementName=OperandA}}}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:ToString 6.78}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:ToString {ux:Bind Path=Margin, RelativeSource={RelativeSource Self}}}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:ToString Value={x:Null}}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:Bind Width, ElementName=OperandA}"/>

                    <TextBox IsReadOnly="True"
                             Text="{Binding Width, ElementName=OperandB}"/>

                    <TextBox IsReadOnly="True"
                             Text="{ux:MultiBind 2, {ux:Add 10, 25}, StringFormat={}{0} # {1}}"/>

                    <TextBox IsReadOnly="True">
                        <TextBox.Text>
                            <ux:MultiBind StringFormat="{}{0} / {1} / {2} / {3}">
                                <ux:Bind Path="Text" ElementName="OperandA"/>
                                <ux:Bind Path="Text" ElementName="OperandB"/>
                                9
                                <ux:Add A="10" B="35"/>
                            </ux:MultiBind>
                        </TextBox.Text>
                    </TextBox>

                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
